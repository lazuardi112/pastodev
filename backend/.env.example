# Salin ke backend/.env

# --- Database (Production / lokal) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xcreatem_store
DB_USER=root
DB_PASSWORD=

# --- Server ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:8080

# --- JWT ---
JWT_SECRET=ganti-dengan-string-rahasia-panjang-minimal-16
JWT_EXPIRE=7d

# --- Google OAuth (opsional) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Midtrans (Snap / QRIS) ---
MIDTRANS_SERVER_KEY=Mid-server-xxx
MIDTRANS_CLIENT_KEY=Mid-client-xxx
MIDTRANS_IS_PRODUCTION=false

# --- Upload ---
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# --- Dev: fallback SQLite jika MySQL gagal (jangan di production) ---
# DB_SQLITE_FALLBACK=true
