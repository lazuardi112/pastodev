# Frontend Vite — salin ke .env di root project (sejajar package.json)
# Samakan port dengan PORT di backend/.env

# URL API lengkap (prioritas tertinggi)
VITE_API_URL=http://localhost:5000/api

# Atau bangun dari host + port (dipakai jika VITE_API_URL kosong)
# VITE_API_HOST=localhost
# VITE_API_PORT=5000

# Midtrans (Client Key — boleh di frontend; Server Key hanya di backend)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxx
VITE_MIDTRANS_IS_PRODUCTION=false
